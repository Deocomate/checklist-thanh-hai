// ---------- Tài liệu ----------
const CATS=[{k:"marketing",name:"Marketing",ic:"📣"},{k:"sale",name:"Sale",ic:"💼"},{k:"product",name:"Sản phẩm",ic:"🏺"}];
const docsUI={brand:"th",q:"",confirm:null};
function pageDocs(){
  const can=state.canWrite&&state.dbOk,b=brandOf(docsUI.brand),q=norm(docsUI.q);
  const mine=state.docs.filter(d=>d.brand===b.k);
  const sec=CATS.map(c=>{
    const list=mine.filter(d=>(d.cat||"marketing")===c.k&&(!q||norm(d.name+" "+d.link).includes(q))).sort((x,y)=>String(x.name).localeCompare(String(y.name),"vi"));
    const rows=list.map(d=>{const u=safeUrl(d.link);
      const act=!can?"":docsUI.confirm===d.id?`<span class="t-bad" style="font-weight:600">Xoá?</span> <button class="dact del" type="button" data-docdelyes="${d.id}">Xoá</button><button class="dact" type="button" data-docdelno="1">Huỷ</button>`:`<button class="dact" type="button" data-docedit="${d.id}">Sửa</button><button class="dact del" type="button" data-docdel="${d.id}">Xoá</button>`;
      return `<tr><td class="dn">${esc(d.name)}</td><td class="lk">${u?`<a href="${esc(u)}" target="_blank" rel="noopener" title="${esc(u)}">${esc(d.link)}</a>`:esc(d.link)}</td><td class="da">${act}</td></tr>`}).join("");
    return `<section class="dsec card"><div class="dsec-h"><span class="ic">${c.ic}</span><h2>${c.name}</h2><span class="tsec-n" style="--sc:${b.c}">${list.length}</span><span class="spacer"></span>${can?`<button class="btn ghost sm" type="button" data-docadd="${c.k}">+ Thêm link</button>`:""}</div>
      ${list.length?`<div class="dscroll"><table class="dt"><thead><tr><th>Tên tài liệu</th><th>Link</th><th class="da">Thao tác</th></tr></thead><tbody>${rows}</tbody></table></div>`:`<p class="dempty">${q?"Không có tài liệu khớp từ khoá.":"Chưa có tài liệu nào trong mục này."}</p>`}</section>`;
  }).join("");
  return `<div class="phead"><div><h1>Tài liệu</h1><p>Link tài liệu cần thiết cho cả nhóm · chia theo brand và mục</p></div>${can?`<button class="btn primary" type="button" data-docadd="">+ Thêm link</button>`:""}</div>
    <div class="toolbar"><div class="seg dseg" role="tablist" aria-label="Brand">${BRANDS.map(x=>`<button type="button" role="tab" data-docbrand="${x.k}" aria-pressed="${x.k===b.k}"><span class="bdot2" style="background:${x.c}"></span>${esc(x.name)} <small>${state.docs.filter(d=>d.brand===x.k).length}</small></button>`).join("")}</div>
      <span class="spacer"></span><input class="input" id="docQ" type="search" placeholder="Tìm tài liệu…" value="${esc(docsUI.q)}" aria-label="Tìm tài liệu" style="min-width:220px"></div>
    <div class="dgrid">${sec}</div>`;
}
function openDoc(d,cat){
  if(!state.canWrite||!state.dbOk)return;
  $("#dlgRoot").innerHTML=`<div class="overlay" id="ov"><form class="modal" id="docForm" data-id="${d?d.id:""}" role="dialog" aria-modal="true" aria-labelledby="docT">
    <h2 id="docT">${d?"Sửa tài liệu":"Thêm link tài liệu"}</h2>
    <div class="f"><label class="label" for="dName">Tên tài liệu</label><input class="input" id="dName" maxlength="120" required placeholder="VD: Báo giá đồ thờ GVG" value="${esc(d?.name||"")}"></div>
    <div class="f"><label class="label" for="dLink">Link</label><input class="input" id="dLink" maxlength="1000" required placeholder="https://…" value="${esc(d?.link||"")}"></div>
    <div class="fgrid">
      <div class="f"><label class="label" for="dBrand">Brand</label><select class="input" id="dBrand">${BRANDS.map(b=>`<option value="${b.k}" ${(d?.brand||docsUI.brand)===b.k?"selected":""}>${esc(b.name)}</option>`).join("")}</select></div>
      <div class="f"><label class="label" for="dCat">Mục</label><select class="input" id="dCat">${CATS.map(c=>`<option value="${c.k}" ${(d?.cat||cat||"marketing")===c.k?"selected":""}>${c.name}</option>`).join("")}</select></div>
    </div>
    <p class="err" id="docErr"></p>
    <div class="mfoot"><span class="spacer"></span><button class="btn secondary" type="button" id="taskCancel">Huỷ</button><button class="btn primary" type="submit" id="docSave">Lưu</button></div>
  </form></div>`;
  $("#dName").focus();
}
document.addEventListener("submit",async e=>{
  if(e.target.id!=="docForm")return;e.preventDefault();e.stopImmediatePropagation();
  const name=$("#dName").value.trim(),link=$("#dLink").value.trim();
  if(!name||!link){$("#docErr").textContent="Nhập tên tài liệu và link.";return}
  if(!safeUrl(link)){$("#docErr").textContent="Link chưa đúng. Hãy dán link bắt đầu bằng https://";return}
  const id=e.target.dataset.id,body={name,link:safeUrl(link),brand:$("#dBrand").value,cat:$("#dCat").value};
  $("#docSave").disabled=true;
  try{if(id)await db.doc("docs/"+id).set(body);else await db.collection("docs").add(body);docsUI.brand=body.brand;closeDlg();render();toast(id?"Đã lưu":"Đã thêm tài liệu")}
  catch(err){$("#docErr").textContent=err?.code==="quota_exceeded"?"Bộ nhớ dữ liệu đã đầy.":"Không lưu được. Kiểm tra mạng rồi thử lại.";$("#docSave").disabled=false}
},true);
document.addEventListener("click",async e=>{
  if(e.target.closest("#dlgRoot"))return;
  const a=e.target.closest("[data-docadd]");if(a){openDoc(null,a.dataset.docadd);return}
  const br=e.target.closest("[data-docbrand]");if(br){docsUI.brand=br.dataset.docbrand;docsUI.confirm=null;render();return}
  const ed=e.target.closest("[data-docedit]");if(ed){openDoc(state.docs.find(d=>d.id===ed.dataset.docedit));return}
  const dl=e.target.closest("[data-docdel]");if(dl){docsUI.confirm=dl.dataset.docdel;render();return}
  if(e.target.closest("[data-docdelno]")){docsUI.confirm=null;render();return}
  const dy=e.target.closest("[data-docdelyes]");if(dy){dy.disabled=true;try{await db.doc("docs/"+dy.dataset.docdelyes).delete();docsUI.confirm=null;toast("Đã xoá tài liệu")}catch(err){toast("Chưa xoá được. Thử lại.");dy.disabled=false}return}
});
document.addEventListener("input",e=>{if(e.target.id==="docQ"){docsUI.q=e.target.value;clearTimeout(docsUI._t);docsUI._t=setTimeout(()=>{const pos=e.target.selectionStart;render();const el=$("#docQ");if(el){el.focus();try{el.setSelectionRange(pos,pos)}catch(_){}}},200)}});

