function applyMode(){$("#onceBox").hidden=dlgMode!=="once";$("#repBox").hidden=dlgMode!=="rep";document.querySelectorAll("[data-mode]").forEach(b=>b.setAttribute("aria-pressed",b.dataset.mode===dlgMode))}
