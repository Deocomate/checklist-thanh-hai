async function saveImport(){
  const list=imp.rows.filter(r=>r.on);if(!list.length||!db)return;
  const btn=document.querySelector('[data-imp="save"]');if(btn){btn.disabled=true;btn.textContent="Đang lưu…"}
  let ok=0,upd=0,fail=0;const base=Math.max(0,...state.tasks.map(t=>t.order||0))+1;
  for(let i=0;i<list.length;i+=5){
    await Promise.all(list.slice(i,i+5).map((r,j)=>{
      const pri=r.due&&r.due<=addWork(today(),1,imp.sunday)?"Cao":"Thường";
      if(r.mode==="replace"&&r.match&&state.tasks.some(t=>t.id===r.match)){
        // thay thế: ghi đè bằng thông tin mới, ô trống trong file thì giữ thông tin cũ
        const p={brand:r.brand,date:r.date};
        [["title",r.title],["group",r.dept],["head",r.head],["owner",r.owner],["due",r.due],["link",r.link],["start",r.start],["end",r.end]].forEach(([k,v])=>{if(v)p[k]=v});
        if(r.due)p.priority=pri;
        return db.doc("tasks/"+r.match).update(p).then(()=>upd++,()=>fail++);
      }
      return db.collection("tasks").add({kind:"once",brand:r.brand,title:r.title||r.head,group:r.dept,head:r.head,owner:r.owner,due:r.due||"",date:r.date,link:r.link,start:r.start||"",end:r.end||"",priority:pri,order:base+i+j,src:"import"}).then(()=>ok++,()=>fail++)}));
  }
  const byDate={};list.forEach(r=>{byDate[r.date]=(byDate[r.date]||0)+1});
  const ds=Object.keys(byDate).sort();
  imp.saved={n:ok,u:upd,first:ds[0]||today(),plan:ds.map(d=>`<div class="pday"><b>${fmtShort(d)}</b><span>${byDate[d]} việc</span></div>`).join("")};
  imp.rows=[];imp.file="";
  if(fail)imp.err=fail+" việc chưa lưu được. Kiểm tra mạng rồi import lại các dòng đó.";
  forceRender();toast([ok?"Đã thêm "+ok+" việc":"",upd?"Đã thay thế "+upd+" việc":""].filter(Boolean).join(" · ")||"Không có thay đổi");
}
async function downloadTemplate(){
  if(!window.XLSX){toast("Chưa tải được bộ tạo Excel. Tải lại trang.");return}
  let dl=null;try{dl=await claude.use("downloads")}catch(e){}
  if(!dl){toast("Trang này chưa cho tải file trong chế độ xem hiện tại.");return}
  const d1=addDays(today(),1),d3=addDays(today(),3),f=d=>{const x=parse(d);return pad(x.getDate())+"/"+pad(x.getMonth()+1)+"/"+x.getFullYear()};
  const wb=XLSX.utils.book_new();
  const ws=XLSX.utils.aoa_to_sheet([["STT","Phòng ban","Đầu việc","Công việc cụ thể","Due date","Phụ trách","Source (đường link)"],[1,"Bán hàng","Check đơn hàng","Check đơn hàng chị Hằng",f(d1),"Nhài",""],[2,"Marketing","Check content","Duyệt bài đăng mosaic.vn tuần sau",f(d3),"",""],[3,"Kế toán","Check công nợ","Đối soát công nợ đại lý Vũ Gia","","",""]]);
  ws["!cols"]=[{wch:5},{wch:14},{wch:20},{wch:42},{wch:12},{wch:14},{wch:30}];
  XLSX.utils.book_append_sheet(wb,ws,"CongViec");
  const n=Math.max(DEPTS.length,HEADS.length),ref=[["Phòng ban","Đầu việc"]];for(let i=0;i<n;i++)ref.push([DEPTS[i]||"",HEADS[i]||""]);
  XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(ref),"DanhMuc");
  const out=XLSX.write(wb,{bookType:"xlsx",type:"array"});
  try{await dl.save({filename:"mau-import-cong-viec.xlsx",data:new Blob([out])});toast("Đã tải file mẫu")}catch(e){if(e?.code!=="declined")toast("Chưa tải được file mẫu.")}
}
document.addEventListener("change",e=>{
  const el=e.target;
  if(el.id==="impFile"&&el.files[0]){readImportFile(el.files[0]);return}
  if(el.id==="impBrand"){imp.brand=el.value;imp.rows.forEach(r=>{if(!r.auto&&!r.brandSet)r.brand=imp.brand});scheduleRows(imp.rows,imp);forceRender();return}
  if(el.id==="impDetect"){imp.detect=el.checked;imp.rows.forEach(r=>{if(r.brandSet)return;const det=imp.detect?detectBrand([r.title,r.head,r.link].join(" ")):null;r.auto=!!det;r.brand=det||imp.brand});scheduleRows(imp.rows,imp);forceRender();return}
  if(el.id==="impStart"){imp.start=el.value;scheduleRows(imp.rows,imp);forceRender();return}
  if(el.id==="impSun"){imp.sunday=el.checked;scheduleRows(imp.rows,imp);forceRender();return}
  if(el.id==="impDup"){imp.dupMode=el.value;imp.rows.forEach(r=>{if(r.match){r.mode=imp.dupMode;r.on=r.mode!=="skip"}});scheduleRows(imp.rows,imp);forceRender();return}
  if(el.id==="impAll"){imp.rows.forEach(r=>r.on=el.checked);scheduleRows(imp.rows,imp);forceRender();return}
  if(el.dataset.r!=null&&state.page==="import"){
    const r=imp.rows[+el.dataset.r],f=el.dataset.f;if(!r)return;
    if(f==="on")r.on=el.checked;else r[f]=el.value.trim?el.value.trim():el.value;
    if(f==="brand"){r.brandSet=true;r.auto=false}
    if(f==="mode"){r.on=r.mode!=="skip"}
    if(f==="brand"||f==="title")refreshMatch(r,true);
    if(f==="date")r.manual=!!el.value;
    if(!["link","start","end"].includes(f))scheduleRows(imp.rows,imp);
    forceRender();
  }
});
document.addEventListener("click",async e=>{
