<!-- Cấu hình + lớp dữ liệu đồng bộ Node.js / SQLite backend -->
<script src="/js/config.js"></script>
<script src="/js/db-adapter.js"></script>
<script>
const BRANDS=[
  {k:"th",name:"TH Ceramics",sub:"Gốm sứ xây dựng",c:"var(--b-th)",hash:"th-ceramics"},
  {k:"mosaic",name:"mosaic.vn",sub:"Gạch mosaic",c:"var(--b-mosaic)",hash:"mosaic"},
  {k:"vugia",name:"Gốm Vũ Gia",sub:"Đồ thờ cúng tâm linh gốm sứ",c:"var(--b-vugia)",hash:"vu-gia"}
];
const GROUP_C=["#c2501d","#8b6fb3","#6b7330","#c9862a","#d9694a","#5d8a84","#a0527a","#7a6a4f"];
const DOW=["T2","T3","T4","T5","T6","T7","CN"], DOWL=["Thứ Hai","Thứ Ba","Thứ Tư","Thứ Năm","Thứ Sáu","Thứ Bảy","Chủ nhật"];
const $=s=>document.querySelector(s);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const CHECK=`<svg width="15" height="15" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 7.5l2.5 2.5L11 4.5" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

// ---------- ngày ----------
const pad=n=>String(n).padStart(2,"0");
const ymd=d=>d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());
const today=()=>ymd(new Date());
const parse=s=>{const [y,m,d]=s.split("-").map(Number);return new Date(y,m-1,d)};
const addDays=(s,n)=>{const d=parse(s);d.setDate(d.getDate()+n);return ymd(d)};
const isoDow=s=>{const g=parse(s).getDay();return g===0?7:g};
const weekStart=s=>addDays(s,1-isoDow(s));
const fmtShort=s=>{const d=parse(s);return DOW[isoDow(s)-1]+" "+d.getDate()+"/"+(d.getMonth()+1)};
const fmtLong=s=>{const d=parse(s);return DOWL[isoDow(s)-1]+", "+d.getDate()+" tháng "+(d.getMonth()+1)+", "+d.getFullYear()};
function monthDays(s){const d=parse(s);const n=new Date(d.getFullYear(),d.getMonth()+1,0).getDate();const out=[];for(let i=1;i<=n;i++)out.push(ymd(new Date(d.getFullYear(),d.getMonth(),i)));return out}
const addMonths=(s,n)=>{const d=parse(s);return ymd(new Date(d.getFullYear(),d.getMonth()+n,1))};

// ---------- trạng thái ----------
const state={docs:[],tasks:[],days:new Map(),cursor:today(),page:"tong-hop",canWrite:true,ready:false,me:null,dbOk:null};
let db=null,user=null;
const subs=new Map(); // tháng -> unsubscribe

const brandOf=k=>BRANDS.find(b=>b.k===k);
const DEPTS=["Kế toán","Bán hàng","Marketing","Dữ liệu","Website","Social media"];
const HEADS=["Check đơn hàng","Check giao hàng","Check công nợ","Check giấy tờ","Check dữ liệu","Check kịch bản","Check content","Check tin nhắn khách"];
// số ngày làm việc tối đa để xếp một việc không có hạn, theo đầu việc
const HEAD_WIN={"Check tin nhắn khách":1,"Check đơn hàng":1,"Check giao hàng":2,"Check dữ liệu":3,"Check content":3,"Check kịch bản":3,"Check giấy tờ":5,"Check công nợ":5};
const isOnce=t=>t.kind==="once";
function occurs(t,s){if(isOnce(t))return t.date===s;if(t.from&&s<t.from)return false;return (t.days||[]).includes(isoDow(s))||(t.mdays||[]).includes(parse(s).getDate())}
const rec=(t,s)=>state.days.get(s)?.done?.[t.id]||null;
const isDone=(t,s)=>!!rec(t,s);
const isDoing=(t,s)=>!!state.days.get(s)?.doing?.[t.id];
const tmin=t=>t.start?(+t.start.slice(0,2))*60+(+t.start.slice(3,5)):9999;
const tasksFor=(brand,s)=>state.tasks.filter(t=>(!brand||t.brand===brand)&&occurs(t,s)).sort((a,b)=>(tmin(a)-tmin(b))||(isOnce(b)-isOnce(a))||(isOnce(a)?String(a.due||"9999").localeCompare(String(b.due||"9999")):0));
const brandTasks=k=>state.tasks.filter(t=>t.brand===k);
function stats(list,s){const done=list.filter(t=>isDone(t,s)).length;return {n:list.length,done}}
function schedLabel(t){
  if(isOnce(t))return "Việc 1 lần"+(t.due?" · hạn "+fmtShort(t.due):"");
  const d=(t.days||[]).slice().sort();let a="";
  if(d.length===7)a="Hằng ngày";else if(d.join()==="1,2,3,4,5,6")a="T2 – T7";else if(d.length)a=d.map(x=>DOW[x-1]).join(" ");
  const m=(t.mdays||[]).slice().sort((x,y)=>x-y);const b=m.length?"Ngày "+m.join(", ")+" hằng tháng":"";
  return [a,b].filter(Boolean).join(" · ")||"Chưa đặt lịch";
}
function groupColor(g){if(!g)return "var(--line2)";let h=0;for(const ch of g)h=(h*31+ch.charCodeAt(0))>>>0;return GROUP_C[h%GROUP_C.length]}
function safeUrl(v){v=String(v||"").trim();if(!v)return "";if(/^https?:\/\//i.test(v))return v;if(/^[\w-]+(\.[\w-]+)+(\/\S*)?$/.test(v))return "https://"+v;return ""}
// việc quá hạn: việc lặp lại trong 7 ngày qua + mọi việc 1 lần đã qua ngày làm mà chưa xong
function overdue(brand,s){
  const out=[];const lim=s<=today()?s:today();
  for(let i=7;i>=1;i--){const d=addDays(lim,-i);tasksFor(brand,d).forEach(t=>{if(!isOnce(t)&&!isDone(t,d))out.push({t,d})})}
  state.tasks.forEach(t=>{if(isOnce(t)&&(!brand||t.brand===brand)&&t.date&&t.date<lim&&!isDone(t,t.date))out.push({t,d:t.date})});
  return out.sort((a,b)=>a.d<b.d?-1:a.d>b.d?1:0);
}
const curPageBrand=()=>BRANDS.find(b=>b.hash===state.page);
function toast(msg){const t=$("#toast");t.textContent=msg;t.hidden=false;clearTimeout(toast._t);toast._t=setTimeout(()=>t.hidden=true,2600)}

// ---------- giao diện ----------
function renderNav(){
  const left=tasksFor(null,today()).filter(t=>!isDone(t,today())).length;
  const items=[{hash:"tong-hop",name:"Tổng hợp",extra:left?`<span class="cnt">${left}</span>`:""},...BRANDS.map(b=>({hash:b.hash,name:b.name,dot:b.c})),{hash:"thang",name:"Tháng"},{hash:"tai-lieu",name:"📚 Tài liệu"},{hash:"import",name:"📥 Import"}];
  $("#nav").innerHTML=items.map(i=>`<button type="button" data-page="${i.hash}" ${state.page===i.hash?'aria-current="page"':""}>${i.dot?`<span class="bd" style="--c:${i.dot}"></span>`:""}${esc(i.name)}${i.extra||""}</button>`).join("");
  $("#roNote").hidden=state.canWrite||!state.dbOk;
}
function render(){
  const ae=document.activeElement;
  if(state.page==="import"&&ae&&ae.closest&&ae.closest("#main")&&/^(INPUT|SELECT)$/.test(ae.tagName)&&ae.type!=="checkbox"&&ae.type!=="file"&&!render._force){state._pending=true;renderNav();return}
  state._pending=false;
  renderNav();
  const notice=state.dbOk===false?`<div class="notice">Không thể kết nối đến server dữ liệu. Vui lòng kiểm tra server Node.js hoặc kết nối mạng.</div>`:"";
  if(!state.ready&&state.dbOk!==false){$("#main").innerHTML=`<div class="empty">Đang tải checklist…</div>`;return}
  $("#main").classList.toggle("wide",state.page==="tong-hop"||state.page==="import");
  if(state.page==="thang") $("#main").innerHTML=notice+pageMonth();
  else if(state.page==="import") $("#main").innerHTML=notice+pageImport();
  else if(state.page==="tai-lieu") $("#main").innerHTML=notice+pageDocs();
  else $("#main").innerHTML=notice+pageDay(curPageBrand());
  fillNames();
}
function headHtml(b){
  const s=state.cursor;
  const title=b?`<span class="bd" style="--c:${b.c}"></span>${esc(b.name)}`:(s===today()?"Hôm nay":"Tổng hợp theo ngày");
  const sub=b?`${esc(b.sub)} · ${fmtLong(s)}`:fmtLong(s);
  return `<div class="phead"><div><h1>${title}</h1><p>${sub}</p></div>
    <div class="row">${state.canWrite&&state.dbOk?`<button class="btn primary" type="button" data-add="${b?b.k:""}">+ Thêm việc</button>`:""}</div></div>
  <div class="toolbar">
    <button class="btn secondary icon" type="button" data-shift="-1" aria-label="Ngày trước">‹</button>
    <input class="input" type="date" id="datePick" value="${s}" aria-label="Chọn ngày">
    <button class="btn secondary icon" type="button" data-shift="1" aria-label="Ngày sau">›</button>
    ${s!==today()?`<button class="btn secondary" type="button" data-go="${today()}">Về hôm nay</button>`:""}
  </div>`;
}
function stripHtml(b){
  const ws=weekStart(state.cursor),td=today();let h="";
  for(let i=0;i<7;i++){
    const d=addDays(ws,i),list=tasksFor(b?.k,d),st=stats(list,d),left=st.n-st.done;
    let c,txt;
    if(!st.n){c="mu";txt="Không có việc"}
    else if(!left){c="ok";txt="Xong hết ✓"}
    else if(d<td){c="bad";txt="Thiếu "+left}
    else if(d===td){c="mid";txt="Còn "+left+" việc"}
    else {c="mu";txt=left+" việc"}
    const dots=(b?[b]:BRANDS).map(x=>{const l=tasksFor(x.k,d);if(!l.length)return "";const s2=stats(l,d);return `<i class="${s2.done===s2.n?"done":""}" style="--c:${x.c}"></i>`}).join("");
    h+=`<button class="sday ${d===td?"today":""} ${d<td?"past":""}" type="button" data-go="${d}" ${d===state.cursor?'aria-current="date"':""}>
      <span class="sd-w">${DOW[i]}</span><span class="sd-n">${parse(d).getDate()}</span><span class="sd-c ${c}">${txt}</span><span class="sd-k sd-c ${c}">${st.n?st.done+"/"+st.n:"–"}</span>
      <span class="sd-s">${st.n?st.done+"/"+st.n+" xong":"&nbsp;"}</span><span class="sd-dots">${dots}</span></button>`;
  }
  return `<div class="card strip">${h}</div>`;
}
function taskHtml(t,s,opt={}){
  const d=isDone(t,s),doing=!d&&isDoing(t,s),r=rec(t,s),b=brandOf(t.brand),can=state.canWrite&&state.dbOk,once=isOnce(t);
  const url=safeUrl(t.link);
  const main=once&&t.head?t.head:t.title;
  const desc=once&&t.head&&norm(t.title)!==norm(t.head)?t.title:"";
  const late=!d&&(opt.late||s<today());
  const pill=d?`<span class="stp ok">Xong</span>`:doing?`<span class="stp doing">Đang làm</span>`:late?`<span class="stp late">${opt.late?"Quá hạn":"Trễ"}</span>`:`<span class="stp">Chưa làm</span>`;
  const meta=[`Phụ trách: <b>${t.owner?esc(t.owner):"Chưa giao"}</b>`];
  if(opt.showBrand)meta.push(`<span style="color:${b.c};font-weight:700">${esc(b.name)}</span>`);
  if(once&&t.due)meta.push(`<span class="${!d&&t.due<=today()?"t-bad":""}">⏳ Hạn ${fmtShort(t.due)}</span>`);
  if(!once)meta.push("🔁 "+esc(schedLabel(t)));
  if(opt.late)meta.push(`<span class="t-bad">ngày làm ${fmtShort(s)}</span>`);
  if(t.priority==="Cao")meta.push(`<span class="t-mid">● Ưu tiên cao</span>`);
  if(d&&r.by)meta.push(`✓ <span data-uid="${esc(r.by)}">xong</span>`);
  const acts=can?[
    !d?`<button class="ab" type="button" data-doing="${t.id}" data-date="${s}">${doing?"⏸ Dừng":"Bắt đầu"}</button>`:"",
    `<button class="ab main ${d?"on":""}" type="button" data-tick="${t.id}" data-date="${s}" aria-pressed="${d}" aria-label="${d?"Bỏ đánh dấu xong":"Đánh dấu xong"}: ${esc(main)}">${d?"↺ Bỏ xong":"✓ Xong"}</button>`,
    url?`<a class="ab" href="${esc(url)}" target="_blank" rel="noopener">🔗 Link</a>`:"",
    opt.late&&once?`<button class="ab" type="button" data-move="${t.id}">Dời sang hôm nay</button>`:"",
    `<button class="ab ghost" type="button" data-edit="${t.id}">Sửa</button>`
  ].join(""):(url?`<a class="ab" href="${esc(url)}" target="_blank" rel="noopener">🔗 Link</a>`:"");
  return `<li class="tk ${opt.compact?"cp":""} ${d?"is-done":""} ${doing?"is-doing":""}" style="--c:${opt.brandBar?b.c:groupColor(t.group)}">
    <div class="tk-time">${t.start?`<b>${esc(t.start)}</b><span>${esc(t.end||"")}</span>`:`<span class="nt">Trong<br>ngày</span>`}</div>
    <div class="tk-body">
      <div class="tk-h"><span class="tk-t">${esc(main)}</span>${pill}</div>
      <div class="tk-m">${meta.join(" · ")}</div>
      ${desc?`<div class="tk-d">${esc(desc)}</div>`:""}
      ${acts?`<div class="tk-a">${acts}</div>`:""}
    </div></li>`;
}
function overSection(b){
  const list=overdue(b?.k,state.cursor);if(!list.length)return "";
  return `<details class="tsec s-over" ${list.length<=4?"open":""}><summary class="tsec-h"><span class="ic">⏰</span><h2>Quá hạn</h2><span class="tsec-n">${list.length}</span><span class="tsec-hint">7 ngày qua chưa tick · bấm để ${list.length<=4?"thu gọn":"xem"}</span></summary>
    <ul class="items" style="margin-top:8px">${list.map(x=>taskHtml(x.t,x.d,{late:true,showBrand:!b,brandBar:!b})).join("")}</ul></details>`;
}
function brandSection(b,s){
  const list=tasksFor(b.k,s),st=stats(list,s);
  const body=list.length?`<ul class="items">${list.map(t=>taskHtml(t,s)).join("")}</ul>`:`<div class="empty">${brandTasks(b.k).length?"Ngày này không có việc theo lịch.":"Chưa có việc nào. Bấm “+ Thêm việc” để tạo."}</div>`;
  return `<section class="tsec" style="--sc:${b.c}"><div class="tsec-h"><span class="ic" style="width:12px;height:12px;border-radius:50%;background:${b.c};display:inline-block"></span><h2>${esc(b.name)}</h2><span class="tsec-n">${st.done}/${st.n}</span><span class="tsec-hint"><button class="btn ghost sm" type="button" data-page="${b.hash}">Mở tab ›</button></span></div>${body}</section>`;
}
function brandCol(b,s){
  const list=tasksFor(b.k,s),st=stats(list,s),p=st.n?Math.round(st.done/st.n*100):0,over=overdue(b.k,s);
  const body=list.length?`<ul class="items">${list.map(t=>taskHtml(t,s,{compact:true})).join("")}</ul>`:`<div class="empty">${brandTasks(b.k).length?"Ngày này không có việc theo lịch.":"Chưa có việc nào."}</div>`;
  const ov=over.length?`<details class="ovbox"><summary>⏰ Quá hạn <span class="tsec-n" style="--sc:#dc2626">${over.length}</span><span class="hintx">bấm để xem</span></summary><ul class="items">${over.map(x=>taskHtml(x.t,x.d,{late:true,compact:true})).join("")}</ul></details>`:"";
  return `<section class="col card" style="--sc:${b.c}">
    <div class="col-h"><div class="col-t"><span class="bdot"></span><h2>${esc(b.name)}</h2><span class="tsec-n">${st.done}/${st.n}</span><span class="spacer"></span><button class="btn ghost sm" type="button" data-page="${b.hash}">Mở tab ›</button></div>
      <div class="prog c" style="--c:${b.c}" role="img" aria-label="${p}% hoàn thành"><i style="width:${p}%"></i></div></div>
    <div class="col-b">${ov}${body}</div></section>`;
}
function groupedList(b,s){
  const list=tasksFor(b.k,s);
  if(!list.length) return `<div class="empty">${brandTasks(b.k).length?"Ngày này không có việc theo lịch.":"Chưa có việc nào. Bấm “+ Thêm việc” để tạo."}</div>`;
  const groups=[];list.forEach(t=>{const g=t.group||"Khác";let x=groups.find(y=>y.g===g);if(!x)groups.push(x={g,items:[]});x.items.push(t)});
  return `<ul class="items">${groups.map(x=>`<li class="grp">${esc(x.g)}</li>${x.items.map(t=>taskHtml(t,s)).join("")}`).join("")}</ul>`;
}
function doneCard(b){
  const s=state.cursor,list=tasksFor(b?.k,s),st=stats(list,s),p=st.n?Math.round(st.done/st.n*100):0;
  const over=overdue(b?.k,s).length;
  return `<div class="card donecard"><div class="row"><span class="big">Đã xong <b>${st.done}</b>/${st.n}</span><div class="spacer"></div>
    ${over?`<span class="badge b-red">${over} quá hạn</span>`:""}<span class="badge ${p===100?"b-green":""}">${p}%</span></div>
    <div class="prog" role="img" aria-label="${p}% hoàn thành"><i style="width:${p}%"></i></div></div>`;
}
function monthDeadlines(b){
  const s=state.cursor,td=today();
  const days=monthDays(s).filter(d=>d>=td||d.slice(0,7)!==td.slice(0,7));
  let h="",n=0;
  days.forEach(d=>{
    const l=state.tasks.filter(t=>(!b||t.brand===b.k)&&(isOnce(t)?t.due===d:(t.mdays||[]).includes(parse(d).getDate())&&occurs(t,d)));
    if(!l.length)return;n+=l.length;
    h+=`<div class="dld ${d===td?"today":""}">${fmtShort(d)}${d===td?" · hôm nay":""}</div>`+l.map(t=>`<div class="dlr ${isDone(t,d)?"is-done":""}"><i style="--c:${brandOf(t.brand).c}"></i><span class="dlt">${esc(t.title)}</span></div>`).join("");
  });
  return `<div class="card sp"><h3>📌 Việc theo hạn trong tháng <small>${n} việc</small></h3>${h||`<p class="dlr" style="color:var(--faint)">Không còn việc theo hạn trong tháng này.</p>`}</div>`;
}
function pageDay(b){
  const s=state.cursor;
  let mainHtml,sideHtml;
  if(!b){
    const st=stats(tasksFor(null,s),s),p=st.n?Math.round(st.done/st.n*100):0,ov=overdue(null,s).length;
    const head=`<div class="chead">
      <h1>${s===today()?"Hôm nay":"Ngày"} <small>${fmtLong(s)}</small></h1>
      <div class="ctools"><button class="btn secondary icon sm2" type="button" data-shift="-1" aria-label="Ngày trước">‹</button>
        <input class="input" type="date" id="datePick" value="${s}" aria-label="Chọn ngày">
        <button class="btn secondary icon sm2" type="button" data-shift="1" aria-label="Ngày sau">›</button>
        ${s!==today()?`<button class="btn secondary sm" type="button" data-go="${today()}">Về hôm nay</button>`:""}</div>
      <span class="spacer"></span>
      <div class="cprog"><span>Đã xong <b>${st.done}</b>/${st.n}</span><div class="prog"><i style="width:${p}%"></i></div><span class="badge ${p===100?"b-green":""}">${p}%</span>${ov?`<span class="badge b-red">${ov} quá hạn</span>`:""}</div>
      ${state.canWrite&&state.dbOk?`<button class="btn primary sm" type="button" data-add="">+ Thêm việc</button>`:""}</div>`;
    return head+stripHtml(null).replace('class="card strip"','class="card strip cp"')+`<div class="cols3">${BRANDS.map(x=>brandCol(x,s)).join("")}</div>`;
    sideHtml=`<div class="card sp"><h3>Tiến độ theo brand <small>${fmtShort(s)}</small></h3>${BRANDS.map(x=>{const st=stats(tasksFor(x.k,s),s),p=st.n?Math.round(st.done/st.n*100):0;return `<div class="bline"><div class="top"><i style="--c:${x.c}"></i><b>${esc(x.name)}</b><span>${st.done}/${st.n} · ${p}%</span></div><div class="prog c" style="--c:${x.c}"><i style="width:${p}%"></i></div></div>`}).join("")}</div>`+monthDeadlines(null);
  } else {
    mainHtml=overSection(b)+`<section class="tsec" style="--sc:${b.c}"><div class="tsec-h"><span class="ic">📋</span><h2>Việc trong ngày</h2><span class="tsec-n">${stats(tasksFor(b.k,s),s).done}/${tasksFor(b.k,s).length}</span><span class="tsec-hint">${fmtShort(s)}</span></div>${groupedList(b,s)}</section>`;
    const ws=weekStart(s);let wn=0,wd=0;for(let i=0;i<7;i++){const d=addDays(ws,i);if(d>today())continue;const st=stats(tasksFor(b.k,d),d);wn+=st.n;wd+=st.done}
    let mn=0,md=0;monthDays(s).forEach(d=>{if(d>today())return;const st=stats(tasksFor(b.k,d),d);mn+=st.n;md+=st.done});
    const pc=(a,c)=>c?Math.round(a/c*100):null;const cls=p=>p==null?"":p>=80?"t-ok":p>=50?"t-mid":"t-bad";
    const pw=pc(wd,wn),pm=pc(md,mn);
    sideHtml=`<div class="tiles"><div class="card tile"><div class="k">Tuần này</div><div class="v ${cls(pw)}">${pw==null?"—":pw+"%"}</div><div class="s">${wd}/${wn} việc tới hôm nay</div></div>
      <div class="card tile"><div class="k">Tháng này</div><div class="v ${cls(pm)}">${pm==null?"—":pm+"%"}</div><div class="s">${md}/${mn} việc tới hôm nay</div></div>
      <div class="card tile"><div class="k">Quá hạn 7 ngày</div><div class="v ${overdue(b.k,s).length?"t-bad":"t-ok"}">${overdue(b.k,s).length}</div><div class="s">việc chưa tick</div></div>
      <div class="card tile"><div class="k">Tổng việc</div><div class="v">${brandTasks(b.k).length}</div><div class="s">trong checklist</div></div></div>`+monthDeadlines(b);
  }
  return headHtml(b)+stripHtml(b)+doneCard(b)+`<div class="daygrid"><div class="main">${mainHtml}</div><aside class="side">${sideHtml}</aside></div>`+(b?matrixHtml(b):"");
}
function matrixHtml(b){
  const s=state.cursor,days=monthDays(s),td=today(),list=brandTasks(b.k).filter(t=>!isOnce(t)),m=parse(s),can=state.canWrite&&state.dbOk;
  if(!list.length)return "";
  const head=days.map(d=>{const dw=DOW[isoDow(d)-1];return `<th class="${dw==="CN"?"cn":""} ${d===td?"today":""}" title="${fmtLong(d)}">${dw}<br>${parse(d).getDate()}</th>`}).join("");
  const body=list.map(t=>{
    let n=0,dn=0;
    const cells=days.map(d=>{const c=d===td?"tdc":"";
      if(!occurs(t,d))return `<td class="${c}"><span class="mc off"><i></i></span></td>`;
      n++;const on=isDone(t,d);if(on)dn++;
      return `<td class="${c}"><button class="mc ${on?"on":d<td?"miss":""}" type="button" data-tick="${t.id}" data-date="${d}" aria-label="${esc(t.title)} – ${fmtShort(d)}: ${on?"đã xong":"chưa xong"}" ${can?"":"disabled"}><i>${on?CHECK:""}</i></button></td>`}).join("");
    return `<tr><th class="tcol" scope="row"><b>${esc(t.title)}</b><span>${esc(schedLabel(t))}${t.owner?" · "+esc(t.owner):""}</span></th><td class="pc">${n?Math.round(dn/n*100)+"%":"—"}</td>${cells}</tr>`;
  }).join("");
  return `<div class="sect-h"><h2>Bảng tháng ${m.getMonth()+1}/${m.getFullYear()}</h2><p>Tick thẳng vào ô ngày · kéo ngang để xem hết tháng</p></div>
    <div class="tw"><table class="mx"><thead><tr><th class="tcol">Công việc</th><th class="pc">%</th>${head}</tr></thead><tbody>${body}</tbody></table></div>
    <div class="legend"><span><i style="background:var(--ok);border-color:var(--ok)"></i>Đã xong</span><span><i></i>Chưa tới / chưa làm</span><span><i style="background:var(--red-bg);border-color:var(--red)"></i>Quá ngày chưa làm</span><span><i style="border:0;background:var(--raised);width:6px;height:6px;border-radius:50%"></i>Không có việc</span></div>`;
}
function pageMonth(){
  const s=state.cursor,m=parse(s),days=monthDays(s),td=today();
  const start=weekStart(days[0]);let rows="",d=start;
  for(let w=0;w<6;w++){
    let cells="";
    for(let i=0;i<7;i++){
      const inM=d.slice(0,7)===s.slice(0,7);
      const all=tasksFor(null,d),st=stats(all,d);
      const chips=BRANDS.map(b=>{const l=tasksFor(b.k,d);if(!l.length)return "";const x=stats(l,d);const cl=x.done===x.n?"done":d<td?"miss":"";return `<span class="mchip ${cl}"><i style="--c:${b.c}"></i>${esc(b.name.replace(/ .*/,""))} ${x.done}/${x.n}</span>`}).join("");
      cells+=`<button class="mcell ${inM?"":"out"} ${d===td?"today":""}" type="button" data-goday="${d}" aria-label="${fmtLong(d)}: ${st.done}/${st.n} việc xong">
        <span class="mtop"><span class="mnum">${parse(d).getDate()}</span>${st.n&&d<td&&st.done<st.n?`<span class="mdot" title="Còn việc chưa xong"></span>`:""}</span>${chips}
        ${st.n?`<span class="mtot ${st.done===st.n?"t-ok":d<td?"t-bad":""}">${st.done}/${st.n}</span>`:""}</button>`;
      d=addDays(d,1);
    }
    rows+=`<div class="mrow">${cells}</div>`;
    if(d.slice(0,7)!==s.slice(0,7)&&d>days[days.length-1])break;
  }
  const tbl=days.map(x=>{
    const all=tasksFor(null,x),st=stats(all,x);let status;
    if(!st.n)status=`<span class="badge">—</span>`;else if(st.done>=st.n)status=`<span class="badge b-green">Hoàn thành</span>`;
    else if(x<td)status=`<span class="badge b-red">Thiếu ${st.n-st.done}</span>`;else if(x===td)status=`<span class="badge b-yellow">Hôm nay</span>`;else status=`<span class="badge">Sắp tới</span>`;
    const cell=(l,c)=>{const z=stats(l,x),p=z.n?Math.round(z.done/z.n*100):0;return z.n?`<div style="display:flex;align-items:center;gap:8px;min-width:120px"><div class="prog c" style="--c:${c};flex:1;height:6px"><i style="width:${p}%"></i></div><span style="font-size:.78rem;font-variant-numeric:tabular-nums;min-width:36px;text-align:right">${z.done}/${z.n}</span></div>`:"—"};
    return `<tr style="cursor:pointer;${x===td?"background:color-mix(in srgb,var(--brand) 9%,transparent)":""}" data-goday="${x}"><td style="white-space:nowrap;font-weight:600;color:var(--ink)">${fmtShort(x)}</td>${BRANDS.map(b=>`<td>${cell(tasksFor(b.k,x),b.c)}</td>`).join("")}<td>${cell(all,"var(--brand)")}</td><td>${status}</td></tr>`;
  }).join("");
  const tot=l=>{let n=0,dn=0;days.forEach(x=>{if(x>td)return;const z=stats(l(x),x);n+=z.n;dn+=z.done});return n?Math.round(dn/n*100)+"% ("+dn+"/"+n+")":"—"};
  return `<div class="phead"><div><h1>Tháng ${m.getMonth()+1}, ${m.getFullYear()}</h1><p>Bấm vào một ngày để xem và tick việc của ngày đó</p></div></div>
    <div class="toolbar"><button class="btn secondary sm" type="button" data-month="-1">‹ Tháng trước</button><button class="btn secondary sm" type="button" data-month="1">Tháng sau ›</button>${s.slice(0,7)!==td.slice(0,7)?`<button class="btn secondary sm" type="button" data-go="${td}">Tháng này</button>`:""}</div>
    <div class="card"><div class="mhead">${DOW.map(x=>`<div>${x}</div>`).join("")}</div>${rows}</div>
    <div class="legend"><span><i style="background:color-mix(in srgb,var(--pine) 30%,transparent);border:0"></i>Brand xong hết</span><span><i style="background:var(--red-bg);border-color:var(--red)"></i>Ngày đã qua còn thiếu</span><span><i style="background:var(--raised);border:0"></i>Chưa tới / đang làm</span></div>
    <div class="sect-h"><h2>Tiến độ theo ngày</h2><p>Tỉ lệ tính tới hôm nay: ${BRANDS.map(b=>esc(b.name)+" "+tot(x=>tasksFor(b.k,x))).join(" · ")}</p></div>
    <div class="tw"><table><thead><tr><th>Ngày</th>${BRANDS.map(b=>`<th>${esc(b.name)}</th>`).join("")}<th>Tổng 3 brand</th><th>Tình trạng</th></tr></thead><tbody>${tbl}</tbody></table></div>`;
}
async function fillNames(){
