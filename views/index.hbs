<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Checklist Đội Gốm</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=Inter:wght@400;500;600;700;800&display=swap">
<style>
/* Layout theo trang mẫu: thanh menu nổi bo tròn + tiêu đề trang + dải 7 ngày + thẻ "đã xong" + các nhóm việc dạng thẻ (cột trái) và cột phụ (phải); tab Tháng là lưới lịch. */
/* Bảng màu theo mẫu "Wash House": nền kem, chữ nâu ô-liu, cam đất, lavender, vàng mù tạt */
:root{
  --canvas:#f5ebdd; --surface:#fbf5ec; --raised:#efe2d0; --line:#e3d3bd; --line2:#cdb89c;
  --ink:#3a3620; --soft:#5a5238; --faint:#83785c;
  --brand:#c2501d; --brand-h:#a5431a; --pine:#6b7330; --pine-t:#4c5320; --sun:#e2a72e; --sun-t:#8a5f00; --red:#b8321e; --red-bg:rgb(184 50 30 / .11);
  --ok:#6b7330; --lav:#9b84c4; --hdr-bg:#d3c7e2; --hdr-ink:#3a3620; --hdr-soft:#4f4834; --hdr-raised:#c3b4d8; --hdr-line:#b8a8cf;
  --page:radial-gradient(ellipse 55% 45% at 100% 0%,#e7dcef 0%,transparent 70%),radial-gradient(ellipse 50% 45% at 0% 100%,#f6d8c2 0%,transparent 70%),linear-gradient(180deg,#f6ecdf 0%,#f2e5d3 100%);
  --card:color-mix(in srgb,#fbf5ec 95%,transparent); --shadow:0 6px 20px rgb(90 60 30 / .14);
  --b-th:#6b7330; --b-mosaic:#8b6fb3; --b-vugia:#c9862a;
  --font:"Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --display:"Fraunces","Iowan Old Style","Georgia",serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --canvas:#1d1a14; --surface:#26221a; --raised:#302a20; --line:#3d3628; --line2:#544a37;
  --ink:#f3e9d8; --soft:#d6c9b0; --faint:#a3977c;
  --brand:#e2733a; --brand-h:#cc6430; --pine:#8f9a52; --pine-t:#c6cf8e; --sun:#f0c25a; --sun-t:#f4d48a; --red:#f08070; --red-bg:rgb(240 128 112 / .15);
  --ok:#8f9a52; --lav:#b9a2dd; --hdr-bg:#2d2738; --hdr-ink:#f3e9d8; --hdr-soft:#d8cde6; --hdr-raised:#3b3349; --hdr-line:#4b415c;
  --page:radial-gradient(ellipse 60% 50% at 100% 0%,#352a47 0%,transparent 70%),radial-gradient(ellipse 55% 50% at 0% 100%,#45281a 0%,transparent 70%),linear-gradient(160deg,#1f1b15 0%,#17140f 100%);
  --card:color-mix(in srgb,#26221a 92%,transparent); --shadow:0 6px 20px rgb(0 0 0 / .4);
  --b-th:#b6be72; --b-mosaic:#b9a2dd; --b-vugia:#e8b552; color-scheme:dark}}
:root[data-theme="dark"]{
  --canvas:#1d1a14; --surface:#26221a; --raised:#302a20; --line:#3d3628; --line2:#544a37;
  --ink:#f3e9d8; --soft:#d6c9b0; --faint:#a3977c;
  --brand:#e2733a; --brand-h:#cc6430; --pine:#8f9a52; --pine-t:#c6cf8e; --sun:#f0c25a; --sun-t:#f4d48a; --red:#f08070; --red-bg:rgb(240 128 112 / .15);
  --ok:#8f9a52; --lav:#b9a2dd; --hdr-bg:#2d2738; --hdr-ink:#f3e9d8; --hdr-soft:#d8cde6; --hdr-raised:#3b3349; --hdr-line:#4b415c;
  --page:radial-gradient(ellipse 60% 50% at 100% 0%,#352a47 0%,transparent 70%),radial-gradient(ellipse 55% 50% at 0% 100%,#45281a 0%,transparent 70%),linear-gradient(160deg,#1f1b15 0%,#17140f 100%);
  --card:color-mix(in srgb,#26221a 92%,transparent); --shadow:0 6px 20px rgb(0 0 0 / .4);
  --b-th:#b6be72; --b-mosaic:#b9a2dd; --b-vugia:#e8b552; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{min-height:100%}
body{font-family:var(--font);color:var(--ink);background:var(--canvas);background-image:var(--page);background-attachment:fixed;-webkit-font-smoothing:antialiased;line-height:1.5;font-size:15px}
h1,h2,h3,p{margin:0}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--sun);outline-offset:2px}
.page{width:100%;max-width:1152px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:26px 40px}

/* Thanh menu nổi */
.hdr{position:sticky;top:calc(8px + env(safe-area-inset-top,0px));z-index:40;margin:8px max(12px,env(safe-area-inset-right,0px)) 0 max(12px,env(safe-area-inset-left,0px));border:1px solid var(--hdr-line);border-radius:16px;background:color-mix(in srgb,var(--hdr-bg) 90%,transparent);backdrop-filter:blur(10px);box-shadow:var(--shadow);color:var(--hdr-ink)}
.hbar{display:flex;align-items:center;gap:8px 20px;min-height:56px;padding:6px 12px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:8px;font-weight:700;white-space:nowrap;flex:1}
.logo svg{width:32px;height:32px;flex:none}
.nav{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;min-width:0}
.nav::-webkit-scrollbar{display:none}
.nav button{border:0;background:transparent;color:var(--hdr-soft);font-weight:500;font-size:.875rem;padding:8px 12px;border-radius:12px;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
.nav button:hover{background:var(--hdr-raised);color:var(--hdr-ink)}
.nav button[aria-current="page"]{background:var(--pine);color:#fff}
.nav .bd{width:8px;height:8px;border-radius:50%;background:var(--c)}
.cnt{display:inline-flex;min-width:18px;height:18px;padding:0 5px;align-items:center;justify-content:center;border-radius:99px;background:var(--brand);color:#fff;font-size:.7rem;font-weight:700}
.hright{flex:1;display:flex;justify-content:flex-end;align-items:center;gap:6px}
.iconbtn{border:0;background:transparent;color:var(--hdr-soft);padding:7px 10px;border-radius:10px;font-size:.8rem;font-weight:600}
.iconbtn:hover{background:var(--hdr-raised);color:var(--hdr-ink)}
.ro{font-size:.75rem;font-weight:600;color:var(--hdr-soft);background:var(--hdr-raised);padding:3px 10px;border-radius:99px}
@media (max-width:1000px){.nav{order:9;flex:1 0 100%}}

/* Tiêu đề trang + nút */
.phead{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:18px}
.phead h1{font-size:1.6rem;font-weight:700;letter-spacing:-.01em;display:flex;align-items:center;gap:10px}
.phead h1 .bd{width:14px;height:14px;border-radius:50%;background:var(--c)}
.phead p{color:var(--soft);font-size:.9rem;margin-top:2px}
.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:16px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:10px;padding:8px 16px;font-size:.875rem;font-weight:500;white-space:nowrap;line-height:1.25}
.btn.primary{background:var(--brand);color:#fff;box-shadow:0 1px 3px rgb(0 0 0 / .3)}
.btn.primary:hover{background:var(--brand-h)}
.btn.secondary{background:var(--surface);color:var(--ink);border-color:var(--line2)}
.btn.secondary:hover{border-color:var(--pine)}
.btn.ghost{background:transparent;color:var(--soft)}
.btn.ghost:hover{background:var(--raised);color:var(--ink)}
.btn.sm{padding:5px 12px;font-size:.78rem}
.btn.icon{width:38px;height:38px;padding:0}
.btn.danger{color:var(--red)}
.input{border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:8px 12px;font-size:.875rem;color:var(--ink);min-width:0}
.card{border:1px solid var(--line);border-radius:14px;background:var(--card);box-shadow:0 1px 3px rgb(0 0 0 / .12);backdrop-filter:blur(4px);min-width:0}

/* Dải 7 ngày */
.strip{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));overflow:hidden;margin-bottom:16px}
.sday{display:flex;flex-direction:column;align-items:center;gap:3px;padding:10px 4px;border:0;border-right:1px solid var(--line);background:transparent;color:var(--ink);min-width:0}
.sday:last-child{border-right:0}
.sday:hover{background:color-mix(in srgb,var(--pine) 16%,transparent)}
.sday[aria-current="date"]{background:color-mix(in srgb,var(--pine) 26%,transparent)}
.sd-w{font-size:.7rem;font-weight:600;color:var(--faint)}
.sd-n{display:inline-flex;min-width:30px;height:30px;align-items:center;justify-content:center;border-radius:50%;font-weight:600;font-size:.9rem}
.sday.today .sd-n{background:var(--brand);color:#fff}
.sday.past .sd-n{color:var(--faint)}
.sd-c{font-size:.72rem;font-weight:700;white-space:nowrap}
.sd-c.bad{color:var(--red)}.sd-c.mid{color:var(--sun-t)}.sd-c.ok{color:var(--pine-t)}.sd-c.mu{color:var(--faint)}
.sd-s{font-size:.7rem;color:var(--faint);font-variant-numeric:tabular-nums}
.sd-dots{display:flex;gap:3px}
.sd-dots i{width:7px;height:7px;border-radius:50%;background:var(--c)}
.sd-dots i.done{opacity:.3}
@media (max-width:640px){.sd-s{display:none}.sd-c{font-size:.66rem}}

/* Thẻ đã xong */
.donecard{padding:14px 18px;margin-bottom:20px;display:grid;gap:10px}
.donecard .row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.donecard .big{font-size:.95rem;color:var(--soft)}
.donecard .big b{font-size:1.6rem;color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums}
.prog{height:8px;border-radius:99px;background:var(--raised);overflow:hidden}
.prog>i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--ok),var(--sun))}
.prog.c>i{background:var(--c)}
.badge{display:inline-flex;align-items:center;gap:4px;border-radius:99px;padding:1px 10px;font-size:.72rem;font-weight:600;white-space:nowrap;background:var(--raised);color:var(--soft);box-shadow:inset 0 0 0 1px var(--line2)}
.b-red{background:var(--red-bg);color:var(--red);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--red) 30%,transparent)}
.b-yellow{background:color-mix(in srgb,var(--sun) 18%,transparent);color:var(--sun-t);box-shadow:none}
.b-green{background:color-mix(in srgb,var(--pine) 30%,transparent);color:var(--pine-t);box-shadow:none}
.spacer{flex:1}

/* Cột chính + cột phụ */
.daygrid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:18px;align-items:start}
@media (max-width:900px){.daygrid{grid-template-columns:1fr}}
.main{display:grid;gap:22px;min-width:0}
.side{display:grid;gap:14px;min-width:0}

/* Nhóm việc */
.tsec{display:grid;gap:8px}
.tsec-h{display:flex;align-items:center;flex-wrap:wrap;gap:4px 10px;padding:8px 12px;border-radius:12px;background:color-mix(in srgb,var(--sc) 14%,var(--surface));border:1px solid color-mix(in srgb,var(--sc) 35%,transparent)}
.tsec-h h2{font-size:1rem;font-weight:700}
.tsec-h .ic{font-size:1.05rem}
.tsec-n{font-size:.75rem;font-weight:700;padding:1px 9px;border-radius:99px;background:var(--sc);color:#fff}
.tsec-hint{margin-left:auto;font-size:.78rem;color:var(--soft)}
.s-over{--sc:#dc2626}
details.tsec>summary{cursor:pointer;list-style:none}
details.tsec>summary::-webkit-details-marker{display:none}
.sd-k{display:none;font-size:.68rem;font-weight:700}
@media (max-width:640px){.sd-c{display:none}.sd-k{display:block}.strip.cp .sday.sday{flex-direction:column;gap:1px}}
.grp{font-size:.74rem;font-weight:700;color:var(--soft);text-transform:uppercase;letter-spacing:.05em;padding:6px 4px 0}
.items{display:grid;gap:8px;list-style:none;margin:0;padding:0}

/* Thẻ việc */
.task{display:flex;align-items:flex-start;gap:12px;padding:12px 14px 12px 12px;border:1px solid var(--line);border-left:4px solid var(--c,var(--line2));border-radius:14px;background:var(--card);box-shadow:0 1px 3px rgb(0 0 0 / .08)}
.task.is-done{opacity:.62}
.task.is-done .t-title{text-decoration:line-through}
.chk{flex:none;width:26px;height:26px;margin-top:1px;border-radius:8px;border:2px solid var(--line2);background:var(--surface);display:inline-flex;align-items:center;justify-content:center;padding:0}
.chk svg{opacity:0}
.chk:hover{border-color:var(--pine)}
.chk[aria-pressed="true"]{background:var(--ok);border-color:var(--ok)}
.chk[aria-pressed="true"] svg{opacity:1}
.chk:disabled{cursor:not-allowed;opacity:.5}
.tb{flex:1;min-width:0}
.l1{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px}
.t-title{font-size:.98rem;font-weight:600;line-height:1.35;overflow-wrap:anywhere}
.pre{font-size:.74rem;font-weight:600;padding:1px 9px;border-radius:99px;color:var(--c);background:color-mix(in srgb,var(--c) 15%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--c) 40%,transparent);white-space:nowrap}
.l2{display:flex;flex-wrap:wrap;gap:2px 14px;margin-top:4px;font-size:.78rem;color:var(--faint)}
.l3{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.l3:empty{display:none}
.edit{flex:none;border:0;background:transparent;color:var(--faint);border-radius:8px;padding:4px 7px;font-size:.85rem}
.edit:hover{background:var(--raised);color:var(--ink)}
/* Import + việc 1 lần */
.lnk{color:var(--brand);font-weight:600;text-decoration:none}
.lnk:hover{text-decoration:underline}
.task.cp .lnk{font-size:.68rem}
.mv{padding:1px 8px!important;font-size:.66rem!important}
.seg{display:flex;flex-wrap:wrap;gap:4px;padding:4px;border:1px solid var(--line);border-radius:12px;background:var(--canvas)}
.seg button{flex:1;border:0;background:transparent;border-radius:8px;padding:7px 12px;font-size:.85rem;font-weight:500;color:var(--soft);white-space:nowrap}
.seg button[aria-pressed="true"]{background:var(--pine);color:#fff}
.fsec{display:grid;gap:12px}
.hint{font-size:.74rem;color:var(--faint)}
.drop{display:flex;flex-direction:column;align-items:center;gap:4px;padding:22px 16px;border:2px dashed var(--line2);cursor:pointer;margin-bottom:14px;text-align:center}
.drop .ic{font-size:1.8rem}
.drop:hover,.drop.over{border-color:var(--brand);background:color-mix(in srgb,var(--brand) 8%,var(--surface))}
.impset{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:flex-end;margin-bottom:14px}
.impset .f{min-width:180px}
.impset .input{width:100%}
.chkline{display:flex;align-items:center;gap:8px;font-size:.86rem;color:var(--soft);padding-bottom:8px}
.impbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:14px 0 10px;font-size:.86rem;color:var(--soft);position:sticky;top:78px;z-index:5;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:8px 12px;backdrop-filter:blur(6px)}
.impbar b{color:var(--ink)}
table.imp td{padding:6px 8px;vertical-align:top}
table.imp th{padding:8px}
table.imp tr.off td{opacity:.5}
table.imp .num{font-variant-numeric:tabular-nums;color:var(--faint)}
.input.xs{padding:5px 7px;font-size:.8rem;border-radius:8px;max-width:170px}
.input.xs.wide{min-width:230px;max-width:none;width:100%}
.plan{display:flex;flex-wrap:wrap;gap:8px}
.pday{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:10px;padding:5px 10px;background:var(--surface);font-size:.82rem}
.pday span{color:var(--faint)}
.pdots i{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--c);margin:0 2px 0 6px}
.dupbox{display:grid;gap:3px;margin-top:4px;font-size:.72rem;color:var(--sun-t)}
.dupbox select{max-width:230px}
.dupset{display:flex;align-items:center;gap:6px;font-size:.8rem;color:var(--soft)}
.okbox{border-color:color-mix(in srgb,var(--pine) 50%,transparent);margin-bottom:14px}
/* Thẻ việc dạng giờ + trạng thái + nút */
.tk{display:flex;gap:14px;padding:12px 14px;border:1px solid var(--line);border-radius:14px;background:var(--card);box-shadow:0 1px 3px rgb(0 0 0 / .08);list-style:none}
.tk-time{width:46px;flex:none;text-align:right;font-variant-numeric:tabular-nums;padding-top:1px}
.tk-time b{display:block;font-weight:700;font-size:.95rem;color:var(--ink)}
.tk-time span{display:block;font-size:.78rem;color:var(--faint)}
.tk-time .nt{font-size:.66rem;line-height:1.2}
.tk-body{flex:1;min-width:0;border-left:3px solid color-mix(in srgb,var(--c) 70%,var(--line2));padding-left:14px}
.tk-h{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px}
.tk-t{font-weight:700;font-size:1.02rem;line-height:1.3;overflow-wrap:anywhere}
.stp{display:inline-flex;align-items:center;border:1px solid var(--line2);border-radius:99px;padding:0 10px;font-size:.74rem;font-weight:600;color:var(--soft);background:var(--surface);white-space:nowrap}
.stp.ok{border-color:color-mix(in srgb,var(--pine) 60%,transparent);color:var(--pine-t);background:color-mix(in srgb,var(--pine) 16%,var(--surface))}
.stp.doing{border-color:color-mix(in srgb,var(--sun) 60%,transparent);color:var(--sun-t);background:color-mix(in srgb,var(--sun) 16%,var(--surface))}
.stp.late{border-color:color-mix(in srgb,var(--red) 50%,transparent);color:var(--red);background:var(--red-bg)}
.tk-m{font-size:.8rem;color:var(--faint);margin-top:3px;overflow-wrap:anywhere}
.tk-m b{color:var(--soft);font-weight:600}
.tk-d{font-size:.9rem;color:var(--soft);margin-top:5px;overflow-wrap:anywhere}
.tk-a{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;align-items:center}
.ab{display:inline-flex;align-items:center;gap:4px;border:1px solid var(--line2);background:var(--surface);color:var(--brand);border-radius:10px;padding:6px 14px;font-weight:600;font-size:.85rem;text-decoration:none;white-space:nowrap}
.ab:hover{border-color:var(--brand)}
.ab.main{background:var(--brand);border-color:var(--brand);color:#fff;box-shadow:0 1px 3px rgb(0 0 0 / .2)}
.ab.main:hover{background:var(--brand-h)}
.ab.main.on{background:var(--surface);color:var(--soft);border-color:var(--line2);box-shadow:none}
.ab.ghost{border-color:transparent;background:transparent;color:var(--soft)}
.ab.ghost:hover{background:var(--raised)}
.tk.is-done{opacity:.7}
.tk.is-done .tk-t{text-decoration:line-through;color:var(--faint)}
.tk.is-doing{box-shadow:0 0 0 2px color-mix(in srgb,var(--sun) 55%,transparent)}
.tk.cp{gap:8px;padding:8px 9px;border-radius:11px;box-shadow:none}
.tk.cp .tk-time{width:36px}
.tk.cp .tk-time b{font-size:.78rem}
.tk.cp .tk-time span{font-size:.66rem}
.tk.cp .tk-time .nt{font-size:.58rem}
.tk.cp .tk-body{padding-left:9px;border-left-width:2px}
.tk.cp .tk-t{font-size:.84rem}
.tk.cp .stp{font-size:.62rem;padding:0 7px}
.tk.cp .tk-m{font-size:.68rem;margin-top:1px}
.tk.cp .tk-d{font-size:.76rem;margin-top:2px}
.tk.cp .tk-a{gap:5px;margin-top:6px}
.tk.cp .ab{padding:3px 9px;font-size:.7rem;border-radius:8px}
.bdot2{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px}
.tinput{display:flex;gap:4px}
.tinput .input{width:84px}
/* Tài liệu */
.dseg button small{opacity:.7;font-weight:600;margin-left:2px}
.dgrid{display:grid;gap:16px}
.dsec{overflow:hidden}
.dsec-h{display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--line)}
.dsec-h h2{font-size:1.02rem;font-weight:700}
.dscroll{overflow-x:auto}
.dt{width:100%;border-collapse:collapse;font-size:.92rem;table-layout:fixed;min-width:560px}
.dt th{background:var(--raised);text-align:left;padding:10px 18px;font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;color:var(--faint);font-weight:600}
.dt th:nth-child(1){width:44%}.dt th:nth-child(3){width:150px}
.dt td{padding:14px 18px;border-top:1px solid var(--line);vertical-align:middle}
.dt tr:hover td{background:color-mix(in srgb,var(--raised) 55%,transparent)}
.dt .dn{font-weight:600;color:var(--ink);overflow-wrap:anywhere}
.dt .lk{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dt .lk a{color:var(--brand);text-decoration:none}
.dt .lk a:hover{text-decoration:underline}
.dt .da{text-align:right;white-space:nowrap}
