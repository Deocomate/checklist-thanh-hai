const LS={get:(k,d)=>{try{const v=localStorage.getItem(k);return v==null?d:v}catch(e){return d}},set:(k,v)=>{try{localStorage.setItem(k,v)}catch(e){}}};
const ui={theme:LS.get("cl-theme","system"),season:LS.get("cl-season2","off"),fx:LS.get("cl-fx","on")!=="off"};
(function buildSeasonCss(){
  const tok=t=>`--page:${t.page};--hdr-bg:${t.hdr};--hdr-raised:${t.raised};--hdr-line:${t.line};--brand:${t.brand};--brand-h:${t.brandh};`;
  let css="";
  for(const [k,s] of Object.entries(SEASONS)){
    css+=`:root[data-season="${k}"]:not([data-theme="dark"]){${tok(s.l)}}\n@media (prefers-color-scheme: dark){:root[data-season="${k}"]:not([data-theme="light"]){${tok(s.d)}}}\n:root[data-season="${k}"][data-theme="dark"]{${tok(s.d)}}\n`;
  }
  const st=document.createElement("style");st.textContent=css;document.head.appendChild(st);
})();
// ngày lễ đang tới gần nhất (trong khoảng trước / sau ngày lễ)
function activeSeason(){
  const td=today(),y=parse(td).getFullYear();let best=null;
  for(const [k,s] of Object.entries(SEASONS)){
    for(const yy of [y-1,y,y+1])for(const d of s.at(yy)){
      const diff=Math.round((parse(d)-parse(td))/864e5);
      if(diff<=s.pre&&diff>=-s.post&&(!best||Math.abs(diff)<Math.abs(best.diff)))best={k,date:d,diff};
    }
  }
  return best;
}
function nextDate(k){const td=today(),y=parse(td).getFullYear();let best=null;for(const yy of [y,y+1])for(const d of SEASONS[k].at(yy)){const diff=Math.round((parse(d)-parse(td))/864e5);if(diff>=-SEASONS[k].post&&(!best||diff<best.diff))best={k,date:d,diff}}return best}
function curSeason(){if(ui.season==="off")return null;if(ui.season==="auto")return activeSeason();return SEASONS[ui.season]?(nextDate(ui.season)||{k:ui.season,date:"",diff:0}):null}
function applyLook(){
  const r=document.documentElement;
  if(ui.theme==="light"||ui.theme==="dark")r.dataset.theme=ui.theme;else delete r.dataset.theme;
  const cs=curSeason();
  if(cs)r.dataset.season=cs.k;else delete r.dataset.season;
  // hiệu ứng rơi
  const sky=$("#sky");sky.innerHTML="";
  const reduce=matchMedia("(prefers-reduced-motion: reduce)").matches;
  if(cs&&ui.fx&&!reduce){
    const em=SEASONS[cs.k].fx;let h="";
    for(let i=0;i<14;i++){const dur=14+Math.random()*14;h+=`<span class="flake" style="left:${(Math.random()*100).toFixed(1)}%;animation-duration:${dur.toFixed(1)}s;animation-delay:-${(Math.random()*dur).toFixed(1)}s;font-size:${(14+Math.random()*14).toFixed(0)}px;--dr:${(Math.random()*80-40).toFixed(0)}px;--sp:${(Math.random()*360-180).toFixed(0)}deg">${em[i%em.length]}</span>`}
    sky.innerHTML=h;
  }
}
function themeMenuHtml(){
  const act=activeSeason();
  const opt=(k,label)=>`<button type="button" class="tm-o" data-season="${k}" aria-pressed="${ui.season===k}">${label}</button>`;
  return `<div class="tm-sec"><div class="tm-h">Giao diện</div><div class="tm-seg">${[["light","☀️ Sáng"],["dark","🌙 Tối"],["system","💻 Theo máy"]].map(([k,l])=>`<button type="button" data-themeset="${k}" aria-pressed="${ui.theme===k}">${l}</button>`).join("")}</div></div>
    <div class="tm-sec"><div class="tm-h">Chủ đề theo mùa</div>
      ${opt("auto","✨ Tự động theo ngày lễ"+(act?` <small>· đang: ${SEASONS[act.k].name}</small>`:` <small>· hiện chưa có ngày lễ</small>`))}
      <div class="tm-grid">${Object.entries(SEASONS).map(([k,s])=>opt(k,s.ic+" "+s.name)).join("")}</div>
      ${opt("off","🧼 Tông kem mặc định (không trang trí)")}
      <label class="tm-fx"><input type="checkbox" id="fxToggle" ${ui.fx?"checked":""}> Hiệu ứng rơi nhẹ</label></div>`;
}
document.addEventListener("click",e=>{
  const btn=e.target.closest("#themeBtn");const menu=$("#themeMenu");
  if(btn){menu.hidden=!menu.hidden;if(!menu.hidden)menu.innerHTML=themeMenuHtml();return}
  if(menu&&!menu.hidden&&!e.target.closest("#themeMenu")){menu.hidden=true;return}
  const ts=e.target.closest("[data-themeset]");if(ts){ui.theme=ts.dataset.themeset;LS.set("cl-theme",ui.theme);applyLook();menu.innerHTML=themeMenuHtml();return}
  const so=e.target.closest("#themeMenu [data-season]");if(so){ui.season=so.dataset.season;LS.set("cl-season2",ui.season);applyLook();menu.innerHTML=themeMenuHtml();return}
});
document.addEventListener("change",e=>{if(e.target.id==="fxToggle"){ui.fx=e.target.checked;LS.set("cl-fx",ui.fx?"on":"off");applyLook()}});
document.addEventListener("keydown",e=>{if(e.key==="Escape"){const m=$("#themeMenu");if(m&&!m.hidden)m.hidden=true}});
applyLook();

// ---------- tương tác ----------
function setCursor(s){state.cursor=s;watchDays();render()}
document.addEventListener("click",e=>{
  if(e.target.closest("#dlgRoot"))return;
  if(e.target.closest("#setBtn")){openSettings();return}
  const dg=e.target.closest("[data-doing]");if(dg){toggle(dg.dataset.doing,dg.dataset.date,"doing");return}
  const tick=e.target.closest("[data-tick]");if(tick&&!tick.disabled){toggle(tick.dataset.tick,tick.dataset.date);return}
  const pg=e.target.closest("[data-page]");if(pg){location.hash=pg.dataset.page;window.scrollTo({top:0});return}
  const ed=e.target.closest("[data-edit]");if(ed){openTask(state.tasks.find(t=>t.id===ed.dataset.edit));return}
  const add=e.target.closest("[data-add]");if(add){openTask(null,add.dataset.add||curPageBrand()?.k);return}
  const sh=e.target.closest("[data-shift]");if(sh){setCursor(addDays(state.cursor,+sh.dataset.shift));return}
  const go=e.target.closest("[data-go]");if(go){setCursor(go.dataset.go);return}
  const gd=e.target.closest("[data-goday]");if(gd){state.cursor=gd.dataset.goday;watchDays();location.hash="tong-hop";if(state.page==="tong-hop")render();window.scrollTo({top:0});return}
  const mo=e.target.closest("[data-month]");if(mo){setCursor(addMonths(state.cursor,+mo.dataset.month));return}
});
document.addEventListener("change",e=>{if(e.target.id==="datePick"&&e.target.value)setCursor(e.target.value)});
document.addEventListener("focusout",()=>{if(state._pending)setTimeout(()=>{if(state._pending)render()},0)});
window.addEventListener("hashchange",()=>{state.page=pageFromHash();render()});
function pageFromHash(){const h=location.hash.slice(1);return ["tong-hop","thang","import","tai-lieu",...BRANDS.map(b=>b.hash)].includes(h)?h:"tong-hop"}
setInterval(()=>{const t=today();if(t!==state._t){state._t=t;render()}},60000);state._t=today();

// ---------- dữ liệu ----------
// theo dõi tháng đang xem + tháng trước (cho phần quá hạn và dải tuần)
function watchDays(){
  if(!db)return;
  const need=new Set([state.cursor.slice(0,7),addDays(weekStart(state.cursor),-7).slice(0,7),addDays(weekStart(state.cursor),6).slice(0,7),today().slice(0,7)]);
  need.forEach(mk=>{
    if(subs.has(mk))return;
    const ds=monthDays(mk+"-01");
    subs.set(mk,db.collection("days").where("date",">=",ds[0]).where("date","<=",ds[ds.length-1]).onSnapshot(snap=>{
      snap.docs.forEach(d=>{const v=d.data();if(v)state.days.set(d.id,v)});
      snap.docChanges().forEach(c=>{if(c.type==="removed")state.days.delete(c.doc.id)});
      render();
    },()=>toast("Mất kết nối dữ liệu. Tải lại trang.")));
  });
  if(subs.size>8){for(const [k,u] of subs){if(!need.has(k)){u();subs.delete(k)}if(subs.size<=6)break}}
}
async function start(){
  state.page=pageFromHash();render();
  try{db=await claude.use("db")}catch(e){db=null}
  if(!db){state.dbOk=false;state.canWrite=false;render();return}
  state.dbOk=true;
  try{user=await claude.use("user")}catch(e){user=null}
  if(user){try{state.me=await user.id()}catch(e){}try{if(await user.can("data.write")===false)state.canWrite=false}catch(e){}}
  db.collection("docs").onSnapshot(snap=>{state.docs=snap.docs.map(d=>({id:d.id,...d.data()}));if(state.page==="tai-lieu")render()},()=>{});
  db.doc("meta/settings").onSnapshot(sn=>{if(sn.exists){applySettings(sn.data());render()}},()=>{});
  db.collection("tasks").onSnapshot(snap=>{
    state.tasks=snap.docs.map(d=>({id:d.id,...d.data()})).sort((a,b)=>(a.order||0)-(b.order||0)||String(a.title).localeCompare(String(b.title),"vi"));
    state.ready=true;render();
  },()=>{state.ready=true;state.dbOk=false;render()});
  watchDays();render();
}
if(window.claude&&typeof claude.use==="function")start();
else{state.page=pageFromHash();state.dbOk=false;state.canWrite=false;render()}
</script>
</body>
</html>
