const imp={rows:[],file:"",brand:"th",detect:true,start:"",sunday:false,saved:null,err:"",dupMode:"replace"};
// tìm việc đã có trùng tên công việc (ưu tiên cùng brand)
function findMatch(r){const n=norm(r.title);if(!n)return null;const once=state.tasks.filter(t=>isOnce(t)&&norm(t.title)===n);return once.find(t=>t.brand===r.brand)||once[0]||null}
function refreshMatch(r,keepMode){const m=findMatch(r);const had=r.match;r.match=m?m.id:null;if(!r.match){if(r.mode!=="new"){r.mode="new";r.on=true}}else if(!keepMode||!had){r.mode=imp.dupMode;r.on=r.mode!=="skip"}}
const norm=s=>String(s??"").replace(/[đĐ]/g,"d").normalize("NFD").replace(/[̀-ͯ]/g,"").toLowerCase().replace(/\s+/g," ").trim();
function detectBrand(text){
  const n=norm(text);
  if(/mosaic/.test(n))return "mosaic";
  if(/vu gia|vugia|do tho|bat huong|tam linh|tho cung/.test(n))return "vugia";
  if(/th ceramic|thceramic|gom su xay dung|su ve sinh|gach op/.test(n))return "th";
  return null;
}
function parseDateCell(v){
  if(v===""||v==null)return "";
  if(typeof v==="number"&&window.XLSX){const o=XLSX.SSF.parse_date_code(v);if(o&&o.y)return ymd(new Date(o.y,o.m-1,o.d));return ""}
  if(v instanceof Date&&!isNaN(v))return ymd(v);
  const s=String(v).trim();let m;
  if((m=s.match(/^(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})/)))return ymd(new Date(+m[1],+m[2]-1,+m[3]));
  if((m=s.match(/^(\d{1,2})[-\/.](\d{1,2})(?:[-\/.](\d{2,4}))?/))){let y=m[3]?+m[3]:parse(today()).getFullYear();if(y<100)y+=2000;const d=new Date(y,+m[2]-1,+m[1]);if(!isNaN(d))return ymd(d)}
  return "";
}
const COLS={stt:["stt"],dept:["phong ban"],head:["dau viec"],title:["cong viec cu the","cong viec","noi dung","mo ta","viec"],due:["due date","due","han chot","deadline","han"],start:["gio bat dau","bat dau","tu gio","start"],end:["gio ket thuc","ket thuc","den gio","end"],owner:["phu trach","nguoi phu trach","nguoi lam"],link:["source","link","duong link","nguon"]};
const urlIn=s=>{const m=String(s||"").match(/https?:\/\/[^\s"'<>]+|www\.[^\s"'<>]+/i);return m?m[0].replace(/[),.;]+$/,""):""};
function parseTimeCell(v){
  if(v===""||v==null)return "";
  if(typeof v==="number"){const f=v%1;const m=Math.round(f*1440)%1440;return pad(Math.floor(m/60))+":"+pad(m%60)}
  const s=String(v).trim().toLowerCase();const m=s.match(/(\d{1,2})\s*(?:[:h.g]|giờ|gio)\s*(\d{1,2})?/)||s.match(/^(\d{1,2})$/);
  if(!m)return "";const h=+m[1],mi=m[2]?+m[2]:0;if(h>23||mi>59)return "";return pad(h)+":"+pad(mi);
}
async function readImportFile(f){
  imp.err="";imp.saved=null;
  if(!window.XLSX){imp.err="Chưa tải được bộ đọc Excel. Kiểm tra mạng rồi tải lại trang.";forceRender();return}
  try{
    const wb=XLSX.read(await f.arrayBuffer(),{type:"array",cellFormula:true});
    const sn=wb.SheetNames.find(n=>norm(n).replace(/ /g,"")==="congviec")||wb.SheetNames[0];
    const ws=wb.Sheets[sn];
    const rg=ws["!ref"]?XLSX.utils.decode_range(ws["!ref"]):{s:{r:0,c:0}};
    const aoa=XLSX.utils.sheet_to_json(ws,{header:1,raw:true,defval:"",blankrows:true});
    // đường link gắn trong ô (hyperlink hoặc công thức HYPERLINK)
    const cellLink=(i,j)=>{const c=ws[XLSX.utils.encode_cell({r:rg.s.r+i,c:rg.s.c+j})];if(!c)return "";if(c.l&&c.l.Target&&!/^#/.test(c.l.Target))return c.l.Target;if(c.f){const m=String(c.f).match(/HYPERLINK\(\s*"([^"]+)"/i);if(m)return m[1]}return ""};
    const hi=aoa.findIndex(r=>r.some(c=>/cong viec|dau viec/.test(norm(c))));
    if(hi<0){imp.err="Không tìm thấy dòng tiêu đề. File cần có các cột: STT, Phòng ban, Đầu việc, Công việc cụ thể, Due date, Phụ trách, Source.";imp.rows=[];forceRender();return}
    const hdr=aoa[hi].map(norm),col={},used=new Set();
    for(const [k,keys] of Object.entries(COLS)){for(const key of keys){const i=hdr.findIndex((h,j)=>!used.has(j)&&h&&(h===key||h.startsWith(key)));if(i>=0){col[k]=i;used.add(i);break}}}
    const get=(r,k)=>col[k]==null?"":r[col[k]];
    const rows=[];
    aoa.forEach((r,i)=>{
      if(i<=hi)return;
      const title=String(get(r,"title")).trim(),head=String(get(r,"head")).trim();
      if(!title&&!head)return;
      const srcText=String(get(r,"link")).trim();
      let link=(col.link!=null&&cellLink(i,col.link))||urlIn(srcText);
      if(!link){for(let j=0;j<r.length&&!link;j++)link=cellLink(i,j);}
      if(!link)link=urlIn(r.join(" "));
      if(!link&&srcText&&safeUrl(srcText))link=srcText;
      const dept=String(get(r,"dept")).trim(),owner=String(get(r,"owner")).trim(),due=parseDateCell(get(r,"due"));
      const det=detectBrand([title,head,link].join(" "));
      const row={on:true,stt:get(r,"stt"),brand:(imp.detect&&det)||imp.brand,auto:!!det,dept,head,title:title||head,due,owner,link,linkText:srcText,start:parseTimeCell(get(r,"start")),end:parseTimeCell(get(r,"end")),date:"",why:"",manual:false,dup:false};
      row.mode="new";refreshMatch(row);
      rows.push(row);
    });
    imp.rows=rows;imp.file=f.name;
    if(!rows.length)imp.err="File không có dòng công việc nào bên dưới tiêu đề.";
    scheduleRows(imp.rows,imp);forceRender();
  }catch(e){console.log(e);imp.err="Không đọc được file. Hãy dùng file .xlsx, .xls hoặc .csv.";imp.rows=[];forceRender()}
}
function impSel(i,f,opts,val){const all=val&&!opts.includes(val)?opts.concat(val):opts;return `<select class="input xs" data-r="${i}" data-f="${f}" aria-label="${f}"><option value="">—</option>${all.map(o=>`<option ${o===val?"selected":""}>${esc(o)}</option>`).join("")}</select>`}
function dupCell(r,i){
  const o=state.tasks.find(t=>t.id===r.match);if(!o)return "";
  const diff=[];const add=(lab,a,b)=>{if((a||"")!==(b||"")&&a)diff.push(lab)};
  add("hạn",r.due,o.due);add("link",r.link,o.link);add("phụ trách",r.owner,o.owner);add("giờ",r.start,o.start);add("phòng ban",r.dept,o.group);add("đầu việc",r.head,o.head);add("brand",r.brand,o.brand);
  return `<div class="dupbox"><span>⚠ Đã có: ${esc(brandOf(o.brand).name)} · ngày ${fmtShort(o.date)}${o.due?" · hạn "+fmtShort(o.due):""}</span>
