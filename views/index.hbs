// ---------- ghi dữ liệu ----------
const chains=new Map();
function queue(key,fn){const p=(chains.get(key)||Promise.resolve()).then(fn,fn);chains.set(key,p.catch(()=>{}));return p}
async function toggle(id,s,field="done"){
  if(!db){toast("Chưa kết nối dữ liệu.");return}
  if(!state.canWrite){toast("Bạn chỉ có quyền xem.");return}
  const t=state.tasks.find(x=>x.id===id);if(!t)return;
  const cur=state.days.get(s)||{date:s,done:{}};
  const prev=cur[field]?.[id]||null,was=!!prev;
  const val=was?null:{by:state.me||"",at:Date.now()};
  state.days.set(s,{...cur,[field]:{...(cur[field]||{}),[id]:val}});render();
  if(!was)toast(field==="done"?"Đã xong ✓":"Đã bắt đầu");
  try{
    await queue(s,async()=>{
      const ref=db.doc("days/"+s);
      try{await ref.update({[field]:{[id]:val}})}
      catch(e){
        if(e&&e.code==="invalid_argument"){const g=await ref.get();if(g.exists)await ref.update({[field]:{[id]:val}});else await ref.set({date:s,[field]:{[id]:val}})}
        else throw e;
      }
    });
  }catch(e){
    if(e&&e.code==="invalid_argument")state.canWrite=false;
    toast(e&&e.code==="quota_exceeded"?"Bộ nhớ dữ liệu đã đầy.":"Chưa lưu được. Kiểm tra mạng rồi thử lại.");
    const c=state.days.get(s);if(c)state.days.set(s,{...c,[field]:{...(c[field]||{}),[id]:prev}});render();
  }
}

// ---------- tự xếp ngày ----------
const isWork=(d,sun)=>sun||isoDow(d)!==7;
function nextWork(d,sun){while(!isWork(d,sun))d=addDays(d,1);return d}
function prevWork(d,sun){d=addDays(d,-1);while(!isWork(d,sun))d=addDays(d,-1);return d}
function addWork(d,n,sun){d=nextWork(d,sun);while(n>0){d=addDays(d,1);if(isWork(d,sun))n--}return d}
// tải việc của một ngày: việc 1 lần cùng người phụ trách (hoặc cùng brand nếu chưa giao) + một phần việc lặp lại của brand
function dayLoad(d,brand,owner,extra,skipId){
  const o=(owner||"").trim().toLowerCase();let n=0;
  for(const t of state.tasks.concat(extra)){
    if(!isOnce(t)||t.date!==d||(skipId&&t.id===skipId))continue;
    if(o?(t.owner||"").trim().toLowerCase()===o:t.brand===brand)n++;
  }
  return n+state.tasks.filter(t=>!isOnce(t)&&t.brand===brand&&occurs(t,d)).length*0.2;
}
function scheduleOne(row,opt,extra=[],skipId){
  const sun=!!opt.sunday,td=today();
  // có hạn: đưa thẳng vào ngày hạn
  if(row.due){
    if(row.due<td)return {date:td,why:"Hạn "+fmtShort(row.due)+" đã qua → làm hôm nay"};
    return {date:row.due,why:"Đưa vào đúng ngày hạn "+fmtShort(row.due)};
  }
  const start=nextWork((opt.start&&opt.start>td)?opt.start:td,sun);
  const w=HEAD_WIN[row.head]||3,end=addWork(start,w-1,sun);
  let why=w===1?"Không có hạn · việc nên làm trong ngày":"Không có hạn · xếp trong "+w+" ngày làm việc";
  let best=start,bl=Infinity;
  for(let d=start;d<=end;d=addDays(d,1)){if(!isWork(d,sun))continue;const l=dayLoad(d,row.brand,row.owner,extra,skipId);if(l<bl-1e-9){bl=l;best=d}}
  if(end>start)why+=" · chọn ngày ít việc nhất";
  return {date:best,why};
}
function scheduleRows(rows,opt){
  const extra=[];
  const idx=rows.map((r,i)=>i).filter(i=>rows[i].on&&!rows[i].manual);
  rows.forEach(r=>{if(r.on&&r.manual)extra.push({kind:"once",date:r.date,brand:r.brand,owner:r.owner})});
  idx.sort((a,b)=>{const A=rows[a],B=rows[b],da=A.due||"9999-99-99",dbb=B.due||"9999-99-99";if(da!==dbb)return da<dbb?-1:1;return (HEAD_WIN[A.head]||3)-(HEAD_WIN[B.head]||3)});
  idx.forEach(i=>{const r=rows[i];
    const old=r.mode==="replace"&&r.match?state.tasks.find(t=>t.id===r.match):null;
    if(old&&old.date&&isDone(old,old.date)){r.date=old.date;r.why="Việc cũ đã xong · giữ ngày "+fmtShort(old.date)}
    else if(old&&old.date&&(!r.due||r.due===(old.due||""))){r.date=old.date;r.why="Giữ ngày làm cũ "+fmtShort(old.date)}
    else{const res=scheduleOne(r,opt,extra,r.match);r.date=res.date;r.why=res.why}
    extra.push({kind:"once",date:r.date,brand:r.brand,owner:r.owner})});
}

