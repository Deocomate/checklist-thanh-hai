# Cấu hình mẫu Nginx Reverse Proxy cho Checklist Thanh Hải
# Đặt file này tại /etc/nginx/sites-available/checklist.conf và symlink sang sites-enabled/

upstream checklist_upstream {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name checklist.yourdomain.com; # Thay bằng domain hoặc IP server của bạn

    # Tự động chuyển hướng sang HTTPS nếu đã cài chứng chỉ SSL (Certbot Let's Encrypt)
    # return 301 https://$host$request-uri;

    access_log /var/log/nginx/checklist.access.log;
    error_log  /var/log/nginx/checklist.error.log;

    client_max_body_size 20M;

    # Cấu hình đặc thù cho Server-Sent Events (SSE) realtime
    location /api/events {
        proxy_pass http://checklist_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Tắt hoàn toàn buffering để event truyền tới trình duyệt tức thời
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 24h;
    }

    # Phục vụ toàn bộ các route và API khác
    location / {
        proxy_pass http://checklist_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
